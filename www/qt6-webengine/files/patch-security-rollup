-  
-  while (destRem != 0)
-  {
-    {
-      size_t size = p->bufConv - p->bufPos;
-      if (size)
-      {
-        if (size > destRem)
-          size = destRem;
-        memcpy(dest, p->buf + p->bufPos, size);
-        p->bufPos += size;
-        *destLen += size;
-        dest += size;
-        destRem -= size;
-        continue;
-      }
-    }
-    
-    p->bufTotal -= p->bufPos;
-    memmove(p->buf, p->buf + p->bufPos, p->bufTotal);
-    p->bufPos = 0;
-    p->bufConv = 0;
-    {
-      size_t size = BRA_BUF_SIZE - p->bufTotal;
-      if (size > srcRem)
-        size = srcRem;
-      memcpy(p->buf + p->bufTotal, src, size);
-      *srcLen += size;
-      src += size;
-      srcRem -= size;
-      p->bufTotal += size;
-    }
-    if (p->bufTotal == 0)
-      break;
-    
-    p->bufConv = p->filter_func(&p->base, p->buf, p->bufTotal);
-
-    if (p->bufConv == 0)
-    {
-      if (!srcWasFinished)
-        break;
-      p->bufConv = p->bufTotal;
-    }
-  }
-
-  if (p->bufTotal == p->bufPos && srcRem == 0 && srcWasFinished)
-  {
-    *status = CODER_STATUS_FINISHED_WITH_MARK;
-    // *wasFinished = 1;
-  }
-
-  return SZ_OK;
