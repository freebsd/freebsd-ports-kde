+std::string GetExtractedStructSamplerName(
+    const std::string uniformNameWithoutIndices,
+    angle::HashMap<std::string, size_t> *extractedSamplerIndices)
+{
+    ASSERT(uniformNameWithoutIndices.find('.') != std::string::npos);
+    ASSERT(uniformNameWithoutIndices.find('[') == std::string::npos);
