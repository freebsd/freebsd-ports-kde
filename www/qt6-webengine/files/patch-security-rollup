+          break;
+        case XZ_ID_IA64:
+          if (v & 0xf)
+            return SZ_ERROR_UNSUPPORTED;
+          break;
+        default: break;
+      }
+      p->ip = v;
+    }
+    else if (propSize != 0)
+      return SZ_ERROR_UNSUPPORTED;
+  }
+  return SZ_OK;
+}
