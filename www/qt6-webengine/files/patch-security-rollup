-  mask = (UInt32)bit - 1; \
-  range += newBound & mask; \
-  mask &= (kBitModelTotal - ((1 << kNumMoveBits) - 1)); \
-  mask += ((1 << kNumMoveBits) - 1); \
-  ttt += (UInt32)((Int32)(mask - ttt) >> kNumMoveBits); \
-  *(prob) = (CLzmaProb)ttt; \
-  RC_NORM(p) \
-  }
-
